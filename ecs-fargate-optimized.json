{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWS ECS Fargate deployment with auto-scaling for Study Buddy application",
  "Parameters": {
    "GeminiApiKey": {
      "Type": "String",
      "Description": "Your Gemini API key for AI functionality",
      "NoEcho": true
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "VPC ID where the service will be deployed"
    },
    "SubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Subnet IDs for the service (at least 2 in different AZs)"
    },
    "ImageUri": {
      "Type": "String",
      "Description": "ECR image URI for the Study Buddy application"
    },
    "MinCapacity": {
      "Type": "Number",
      "Default": 1,
      "Description": "Minimum number of tasks"
    },
    "MaxCapacity": {
      "Type": "Number",
      "Default": 10,
      "Description": "Maximum number of tasks"
    },
    "Environment": {
      "Type": "String",
      "Default": "production",
      "AllowedValues": ["development", "staging", "production"],
      "Description": "Environment name"
    }
  },
  "Mappings": {
    "EnvironmentConfig": {
      "development": {
        "CPU": "256",
        "Memory": "512",
        "DesiredCount": 1,
        "LogRetention": 3
      },
      "staging": {
        "CPU": "512",
        "Memory": "1024", 
        "DesiredCount": 1,
        "LogRetention": 7
      },
      "production": {
        "CPU": "1024",
        "Memory": "2048",
        "DesiredCount": 2,
        "LogRetention": 30
      }
    }
  },
  "Resources": {
    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {"Fn::Sub": "studyapp-${Environment}-cluster"},
        "CapacityProviders": ["FARGATE", "FARGATE_SPOT"],
        "DefaultCapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1,
            "Base": 1
          },
          {
            "CapacityProvider": "FARGATE_SPOT",
            "Weight": 4
          }
        ],
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "TaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "studyapp-${Environment}-execution-role"},
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "SecretsManagerAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {"Ref": "GeminiApiSecret"}
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",   
      "Properties": {
        "RoleName": {"Fn::Sub": "studyapp-${Environment}-task-role"},
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CloudWatchMetrics",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricData"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "GeminiApiSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {"Fn::Sub": "studyapp/${Environment}/gemini-api-key"},
        "Description": "Gemini API key for Study Buddy application",
        "SecretString": {"Ref": "GeminiApiKey"}
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/ecs/studyapp-${Environment}"},
        "RetentionInDays": {
          "Fn::FindInMap": ["EnvironmentConfig", {"Ref": "Environment"}, "LogRetention"]
        }
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {"Fn::Sub": "studyapp-${Environment}-task"},
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "Cpu": {
          "Fn::FindInMap": ["EnvironmentConfig", {"Ref": "Environment"}, "CPU"]
        },
        "Memory": {
          "Fn::FindInMap": ["EnvironmentConfig", {"Ref": "Environment"}, "Memory"]
        },
        "ExecutionRoleArn": {"Ref": "TaskExecutionRole"},
        "TaskRoleArn": {"Ref": "TaskRole"},
        "ContainerDefinitions": [
          {
            "Name": "studyapp-container",
            "Image": {"Ref": "ImageUri"},
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Essential": true,
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "FLET_WEB_RENDERER",
                "Value": "html"
              },
              {
                "Name": "ENVIRONMENT",
                "Value": {"Ref": "Environment"}
              },
              {
                "Name": "AWS_DEFAULT_REGION",
                "Value": {"Ref": "AWS::Region"}
              }
            ],
            "Secrets": [
              {
                "Name": "GEMINI_API_KEY",
                "ValueFrom": {"Ref": "GeminiApiSecret"}
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {"Ref": "LogGroup"},
                "awslogs-region": {"Ref": "AWS::Region"},
                "awslogs-stream-prefix": "ecs"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "curl -f http://localhost:8080/health || exit 1"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            },
            "ResourceRequirements": [],
            "Ulimits": [
              {
                "Name": "nofile",
                "SoftLimit": 65536,
                "HardLimit": 65536
              }
            ]
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {"Fn::Sub": "studyapp-${Environment}-ecs-sg"},
        "GroupDescription": "Security group for Study Buddy ECS service",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {"Ref": "LoadBalancerSecurityGroup"}
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {"Fn::Sub": "studyapp-${Environment}-ecs-sg"}
          },
          {
            "Key": "Environment",
            "Value": {"Ref": "Environment"}
          }
        ]
      }
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {"Fn::Sub": "studyapp-${Environment}-alb-sg"},
        "GroupDescription": "Security group for Application Load Balancer",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {"Fn::Sub": "studyapp-${Environment}-alb-sg"}
          },
          {
            "Key": "Environment",
            "Value": {"Ref": "Environment"}
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": {"Fn::Sub": "studyapp-${Environment}-alb"},
        "Scheme": "internet-facing",
        "Type": "application",
        "IpAddressType": "ipv4",
        "Subnets": {"Ref": "SubnetIds"},
        "SecurityGroups": [{"Ref": "LoadBalancerSecurityGroup"}],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "60"
          },
          {
            "Key": "routing.http2.enabled",
            "Value": "true"
          },
          {
            "Key": "access_logs.s3.enabled",
            "Value": "false"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {"Fn::Sub": "studyapp-${Environment}-alb"}
          },
          {
            "Key": "Environment",
            "Value": {"Ref": "Environment"}
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {"Fn::Sub": "studyapp-${Environment}-tg"},
        "Port": 8080,
        "Protocol": "HTTP",
        "VpcId": {"Ref": "VpcId"},
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 10,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 5,
        "HealthCheckProtocol": "HTTP",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          },
          {
            "Key": "stickiness.enabled", 
            "Value": "true"
          },
          {
            "Key": "stickiness.type",
            "Value": "lb_cookie"
          },
          {
            "Key": "stickiness.lb_cookie.duration_seconds",
            "Value": "86400"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {"Fn::Sub": "studyapp-${Environment}-tg"}
          },
          {
            "Key": "Environment",
            "Value": {"Ref": "Environment"}
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {"Ref": "TargetGroup"}
          }
        ],
        "LoadBalancerArn": {"Ref": "LoadBalancer"},
        "Port": 80,
        "Protocol": "HTTP"
      }
    },
    "ECSService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "Listener",
      "Properties": {
        "ServiceName": {"Fn::Sub": "studyapp-${Environment}-service"},
        "Cluster": {"Ref": "ECSCluster"},
        "TaskDefinition": {"Ref": "TaskDefinition"},
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Fn::FindInMap": ["EnvironmentConfig", {"Ref": "Environment"}, "DesiredCount"]
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 50,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [{"Ref": "SecurityGroup"}],
            "Subnets": {"Ref": "SubnetIds"},
            "AssignPublicIp": "ENABLED"
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "studyapp-container",
            "ContainerPort": 8080,
            "TargetGroupArn": {"Ref": "TargetGroup"}
          }
        ],
        "HealthCheckGracePeriodSeconds": 120,
        "ServiceTags": [
          {
            "Key": "Name",
            "Value": {"Fn::Sub": "studyapp-${Environment}-service"}
          },
          {
            "Key": "Environment",
            "Value": {"Ref": "Environment"}
          }
        ]
      }
    },
    "ServiceScalingTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": {"Ref": "MaxCapacity"},
        "MinCapacity": {"Ref": "MinCapacity"},
        "ResourceId": {
          "Fn::Sub": "service/${ECSCluster}/${ECSService.Name}"
        },
        "RoleARN": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "ServiceScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {"Fn::Sub": "studyapp-${Environment}-scaling-policy"},
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {"Ref": "ServiceScalingTarget"},
        "TargetTrackingScalingPolicyConfiguration": {
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "TargetValue": 70.0,
          "ScaleOutCooldown": 300,
          "ScaleInCooldown": 300
        }
      }
    },
    "CPUAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "studyapp-${Environment}-high-cpu"},
        "AlarmDescription": "High CPU utilization alarm",
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Ref": "ECSService"}
          },
          {
            "Name": "ClusterName",
            "Value": {"Ref": "ECSCluster"}
          }
        ]
      }
    },
    "MemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "studyapp-${Environment}-high-memory"},
        "AlarmDescription": "High memory utilization alarm",
        "MetricName": "MemoryUtilization",
        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Ref": "ECSService"}
          },
          {
            "Name": "ClusterName",
            "Value": {"Ref": "ECSCluster"}
          }
        ]
      }
    }
  },
  "Outputs": {
    "LoadBalancerURL": {
      "Description": "URL of the load balancer",
      "Value": {
        "Fn::Sub": "http://${LoadBalancer.DNSName}"
      },
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-LoadBalancerURL"}
      }
    },
    "LoadBalancerDNS": {
      "Description": "DNS name of the load balancer",
      "Value": {"Fn::GetAtt": ["LoadBalancer", "DNSName"]},
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-LoadBalancerDNS"}
      }
    },
    "ClusterName": {
      "Description": "Name of the ECS cluster",
      "Value": {"Ref": "ECSCluster"},
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-ClusterName"}
      }
    },
    "ServiceName": {
      "Description": "Name of the ECS service",
      "Value": {"Ref": "ECSService"},
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-ServiceName"}
      }
    },
    "TaskDefinitionArn": {
      "Description": "ARN of the task definition",
      "Value": {"Ref": "TaskDefinition"},
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-TaskDefinitionArn"}
      }
    },
    "SecurityGroupId": {
      "Description": "Security group ID for ECS tasks",
      "Value": {"Ref": "SecurityGroup"},
      "Export": {
        "Name": {"Fn::Sub": "${AWS::StackName}-SecurityGroupId"}
      }
    }
  }
}
