{
  "ServiceName": "myAi-fixed",
  "SourceConfiguration": {
    "Repository": {
      "RepositoryUrl": "https://github.com/marvinweish/Studyapp",
      "SourceCodeVersion": {
        "Type": "BRANCH",
        "Value": "master"
      },
      "CodeConfiguration": {
        "ConfigurationSource": "REPOSITORY",
        "CodeConfigurationValues": {
          "Runtime": "PYTHON_3",
          "BuildCommand": "pip install -r requirements.txt",
          "StartCommand": "python study_app.py",
          "RuntimeEnvironmentVariables": {
            "PORT": "8080",
            "FLET_WEB_RENDERER": "html",
            "PYTHONUNBUFFERED": "1"
          }
        }
      }
    },
    "AutoDeploymentsEnabled": true
  },
  "InstanceConfiguration": {
    "Cpu": "0.25 vCPU",
    "Memory": "0.5 GB"
  },
  "Tags": [
    {
      "Key": "Application",
      "Value": "StudyBuddy"
    },
    {
      "Key": "Environment",
      "Value": "Production"
    }
  ]
}
